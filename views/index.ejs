<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>URL Shortener</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>URL Shortener</h1>

        <p>Convert your long URL into a short link.</p>

        <form action="/shorten" method="POST">

            <input
                type="url"
                name="original_url"
                placeholder="https://example.com"
                required
            >

            <button type="submit">
                Shorten URL
            </button>

        </form>

    </div>

    <footer>
        <p>URL Shortener Project | Node.js + Express + MySQL</p>
    </footer>

</body>
</html>